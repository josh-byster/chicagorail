PORT=3000
NODE_ENV=development
GTFS_UPDATE_INTERVAL=86400000

# Metra GTFS-realtime feed (optional).
# Without a token the API serves scheduled times only.
# A "key:secret" pair is sent as HTTP Basic; any other value as a Bearer token.
# Set GTFS_AUTH_SCHEME=basic|bearer to override that guess.
GTFS_TOKEN=
# GTFS_AUTH_SCHEME=bearer
# METRA_RT_URL=https://gtfsapi.metrarail.com/gtfs
