{
  "name": "chicagorail",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream dev",
    "build": "pnpm --filter @chicagorail/shared build && pnpm --filter @chicagorail/backend build",
    "backend:dev": "pnpm --filter @chicagorail/backend dev",
    "frontend:dev": "pnpm --filter @chicagorail/frontend dev",
    "shared:build": "pnpm --filter @chicagorail/shared build",
    "start": "node packages/backend/dist/index.js"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
