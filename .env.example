# ==========================================
# Metra Train Tracker - Environment Variables
# ==========================================
#
# IMPORTANT: Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it's in .gitignore)
#

# ==========================================
# GTFS API Configuration
# ==========================================

# Metra GTFS API Token
# Request your API token at: https://gtfspublic.metrarr.com
METRA_API_TOKEN=your_api_token_here

# GTFS Static Schedule Endpoints (Standard GTFS Format)
# Static feed URL (ZIP file with GTFS .txt files)
# No authentication required for static feed
GTFS_STATIC_SCHEDULE_URL=https://schedules.metrarail.com/gtfs/schedule.zip

# Published timestamp URL (check for schedule updates)
# Contains the date/time when the schedule was last published
GTFS_STATIC_PUBLISHED_URL=https://schedules.metrarail.com/gtfs/published.txt

# GTFS Realtime Endpoints (Protocol Buffer format)
# Requires API token authentication (Bearer token or api_token query param)
GTFS_REALTIME_ALERTS_URL=https://gtfspublic.metrarr.com/gtfs/public/alerts
GTFS_REALTIME_TRIP_UPDATES_URL=https://gtfspublic.metrarr.com/gtfs/public/tripupdates
GTFS_REALTIME_POSITIONS_URL=https://gtfspublic.metrarr.com/gtfs/public/positions

# Polling interval for realtime data (milliseconds)
# Metra updates realtime data every 30 seconds
GTFS_REALTIME_POLL_INTERVAL=30000

# ==========================================
# Backend Configuration
# ==========================================

# Server port
PORT=3000

# Node environment (development, production, test)
NODE_ENV=development

# SQLite database path
DATABASE_PATH=./data/gtfs.db

# API request timeout (milliseconds)
API_TIMEOUT=5000

# CORS Configuration
# Comma-separated list of allowed origins, or "*" to allow all
# By default: localhost origins allowed in development, Vercel.app and chicagorail.app subdomains always allowed
# Examples:
#   CORS_ORIGIN=*                                    # Allow all origins
#   CORS_ORIGIN=https://example.com                  # Allow single origin
#   CORS_ORIGIN=https://example.com,https://app.example.com  # Allow multiple origins
# CORS_ORIGIN=

# ==========================================
# Frontend Configuration
# ==========================================

# Backend API URL (used by frontend to connect to backend)
# For local development
VITE_API_URL=http://localhost:3000/api
# For production (Vercel will proxy /api to backend)
# VITE_API_URL=https://chicagorail.app/api

# ==========================================
# Optional: Monitoring & Error Tracking
# ==========================================

# Sentry DSN (optional, for error tracking)
# SENTRY_DSN=your_sentry_dsn_here

# ==========================================
# Optional: Deployment
# ==========================================

# DigitalOcean App Platform deployment settings
# DIGITALOCEAN_APP_ID=your_app_id_here
