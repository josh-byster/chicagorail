# ==========================================
# Test Environment Configuration
# ==========================================
# This file is used for E2E testing with Playwright
# Realtime features are disabled for testing

# ==========================================
# GTFS API Configuration
# ==========================================

# Metra GTFS API Token (empty for tests - realtime disabled)
METRA_API_TOKEN=

# GTFS Static Schedule Endpoints (public URLs - no auth required)
GTFS_STATIC_SCHEDULE_URL=https://schedules.metrarail.com/gtfs/schedule.zip
GTFS_STATIC_PUBLISHED_URL=https://schedules.metrarail.com/gtfs/published.txt

# GTFS Realtime Endpoints (disabled for testing)
GTFS_REALTIME_ALERTS_URL=
GTFS_REALTIME_TRIP_UPDATES_URL=
GTFS_REALTIME_POSITIONS_URL=

# Polling interval (not used in tests)
GTFS_REALTIME_POLL_INTERVAL=30000

# ==========================================
# Backend Configuration
# ==========================================

# Server port (different from dev to avoid conflicts)
PORT=3001

# Node environment
NODE_ENV=test

# SQLite database path (test database)
DATABASE_PATH=./data/gtfs.test.db

# API request timeout
API_TIMEOUT=5000

# CORS Configuration (allow all for tests)
CORS_ORIGIN=*

# ==========================================
# Frontend Configuration
# ==========================================

# Backend API URL for tests
VITE_API_URL=http://localhost:3001/api
